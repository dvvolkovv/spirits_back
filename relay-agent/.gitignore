# Секрет: GEMINI_API_KEY. Живёт только на сервере.
.env

# 69 МБ, ставятся из package-lock.json.
node_modules/

# Ручные бэкапы: их заменяет история git.
*.bak
*.bak.*
*.bak-*
_old-backups/

# Рабочие каталоги агента на сервере.
sessions/
uploads/
*.log

# Секреты бэков и режим проверки (relay-auth.mjs). Живут только на сервере,
# права 600. Звёздочка — из-за атомической записи (временный файл рядом,
# потом mv): relay-secrets.tmp-* тоже не должен попасть в git.
relay-secrets*
relay-auth-mode*
