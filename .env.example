PORT=3001
NODE_ENV=production

DATABASE_URL=postgresql://linkeon:PASSWORD@localhost:5432/linkeon

REDIS_URL=redis://localhost:6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

JWT_SECRET=change_me_to_strong_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=7200
JWT_REFRESH_EXPIRES=2592000

# Соль ключа папки хода на релее (fs_key, src/chat/linkeon-relay-fields.ts).
# У прода и стенда — разные значения. Без неё используется JWT_SECRET (с
# предупреждением в лог); без обоих fs_key не выдаётся вовсе.
RELAY_FS_SALT=

SMSAERO_LOGIN=your_login
SMSAERO_API_KEY=your_api_key

# Лимиты отправки SMS с кодом (src/auth/sms-limits.ts). Не заданы — действуют
# умолчания из кода (ниже). Только целое больше нуля; после правки — перезапуск.
# SMS_LIMIT_PHONE_INTERVAL_SEC=60
# SMS_LIMIT_PHONE_PER_HOUR=3
# SMS_LIMIT_PHONE_PER_DAY=5
# SMS_LIMIT_GLOBAL_PER_HOUR=30
# SMS_LIMIT_GLOBAL_PER_DAY=100
# SMS_LIMIT_INTL_PER_HOUR=5
# SMS_LIMIT_INTL_PER_DAY=15
# SMS_LIMIT_KNOWN_PER_HOUR=60
# SMS_LIMIT_KNOWN_PER_DAY=200
# Лимиты писем со ссылкой входа за 10 минут (src/auth/email.service.ts).
# EMAIL_LIMIT_PER_ADDRESS_10MIN=3
# EMAIL_LIMIT_GLOBAL_10MIN=60

OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
# Claude доступ — через OAuth (~/.claude/.credentials.json на сервере).
# Один раз: `claude login` под нужным пользователем. Никаких API-ключей.

YOOKASSA_SHOP_ID=...
YOOKASSA_SECRET_KEY=...

AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=...

SMS_WEBHOOK_UUID=898c938d-f094-455c-86af-969617e62f7a
CHECK_WEBHOOK_UUID=a376a8ed-3bf7-4f23-aaa5-236eea72871b
AVATAR_WEBHOOK_UUID=0cdacf32-7bfd-4888-b24f-3a6af3b5f99e

DEBUG_SMS_CODES=false
# Секрет заголовка X-Debug-Secret для /webhook/debug/* (≥32 знаков, openssl rand -hex 32).
# Без него debug-ручки выключены даже при DEBUG_SMS_CODES=true. В репозиторий не класть.
# Закомментировано нарочно: пустая строка DEBUG_SECRET= останавливает deploy.sh,
# а отсутствующую он допишет сам (ensure_debug_secret).
# DEBUG_SECRET=

# Секрет заголовка X-Agent-Secret к релею (r.linkeon.io), 32 случайных байта
# в hex (openssl rand -hex 32). У прода и стенда — свои значения; релей
# принимает любое из своего списка. Без него relayAuthHeaders() не добавляет
# заголовок (src/chat/relay-auth.ts) — в режиме enforce релей откажет в ходе.
# В репозиторий не класть, scripts/sync-api-keys-to-test.sh этот ключ не копирует.
RELAY_SECRET=

# Telegram bot integration
TG_BOT_TOKEN=
TG_WEBHOOK_URL_SECRET=
TG_WEBHOOK_HEADER_SECRET=
TG_WEBHOOK_BASE_URL=https://my.linkeon.io
TG_BOT_USERNAME=LinkeonAgentBot
TG_BOT_LOW_BALANCE_THRESHOLD=1000

# Продукты: шифрование секретов (токен бота, ключи бирж) в products.secrets_encrypted.
# 32 байта в hex, ровно 64 символа [0-9a-f]. Сгенерировать: openssl rand -hex 32
# Значения для test и прода кладёт владелец; ключ один на все продукты, коробка
# привязана к productId через AAD. Смена ключа делает старые коробки нечитаемыми —
# отличать поколения по ведущему байту версии формата.
PRODUCT_SECRETS_KEY=

# Продукты: токен агента машины продуктов. Агент живёт на машине, long-poll'ит
# бэкенд за заданиями провижининга и разворачивает контейнеры; этим токеном он
# доказывает, что он — та самая машина (не пользователь и не раннер продукта).
# Сгенерировать: openssl rand -hex 32
# Значение обязано совпадать с HOST_TOKEN в /etc/linkeon-host-agent.env на машине
# продуктов. Не совпало — агент не получит ни одного задания и промолчит: снаружи
# это выглядит как «кнопка не работает», а не как ошибка доступа.
#
# ЭТА ПЕРЕМЕННАЯ — ТОЛЬКО ЗАСЕВ. Гвард её не читает: с куска 4а токен агента и
# есть МЕТКА МАШИНЫ, а машины лежат в таблице product_hosts (sha256 токена в
# agent_token_hash — как runner_token_hash у продукта). Отсюда заводится ровно
# одна, первая — `own`, миграцией 005 при первом накате. Дальше источник правды
# один: реестр. Вторую машину и поворот токена делают правкой реестра, а
# ЭТУ ПЕРЕМЕННУЮ ПОСЛЕ ВЫКАТА ИЗ .env УДАЛЯЮТ — оставленная, она была бы вторым
# способом пройти гвард, расходящимся с реестром молча (сторож — сценарий 42а).
#
# Требования к токену проверяются на каждом запросе, не только комментарием:
#   - не короче 32 символов (заглушки вроде `test` отвергаются до базы);
#   - только печатный ASCII без пробелов — значения HTTP-заголовков латинские,
#     и неASCII-токен агенту не отправить в принципе (ERR_INVALID_CHAR), а
#     хвостовой пробел давал бы вечный 401 без подсказки.
# Пустое значение здесь не открывает вход, а закрывает: 005 не заведёт машину
# вовсе, реестр останется пустым, и гвард отвергнет всех со строкой в логе
# «реестр машин пуст» (наружу — «host registry not configured»).
# Предъявленный, но неизвестный токен — строка «неизвестный токен агента машины
# (sha256 ...)» и «Unknown host token» наружу; сам токен в лог не уезжает.
PRODUCT_HOST_TOKEN=

# ── Встречи: бот и его вебхуки ───────────────────────────────────────────────
#
# Свой сервис ботов (infra/meeting-bot) — через него ходят Телемост, Zoom и
# Meet. Адрес и ключ выдаёт scripts/provision-bots.sh при установке машины.
MEETING_BOT_URL=
MEETING_BOT_API_KEY=

# КУДА БОТ СООБЩАЕТ О СЕБЕ. Без этих двух переменных встречи ломаются молча, и
# это не предположение — так прожило до 19.10.2026.
#
# Вебхуками едут СОСТАВ УЧАСТНИКОВ, КТО ГОВОРИТ и ОТКАЗЫ ВХОДА. Пока их нет:
#   • ассистент не знает, кто с ним во встрече, — гейт по имени не видит
#     режима «наедине», а правила выхода считают встречу пустой и уводят его
#     через LOBBY_MS (живая встреча в Телемосте 13.10.2026: вышел через
#     пятнадцать минут при живых участниках);
#   • бот, не сумевший войти, не может об этом сказать — звонок остаётся
#     висеть в `dialing`, а пользователю написано «ассистент на встрече»
#     (Meet 19.10.2026).
#
# Незаметно это было потому, что обе стороны молчали: бэкенд подставлял пустой
# адрес (`ATTENDEE_WEBHOOK_URL || ''`), а бот на пустом адресе возвращал
# «успех», не отправив ничего. Теперь и то и другое — явный отказ, см.
# meetingBotConfigured() и createBot() в src/meeting/attendee.client.ts.
#
# URL — ручка этого же бэкенда, путь с глобальным префиксом `webhook`.
# SECRET — РОВНО то же значение, что MEETING_BOT_WEBHOOK_SECRET в
# infra/meeting-bot/.env на машине ботов: подпись считается им с обеих сторон.
ATTENDEE_WEBHOOK_URL=https://my.linkeon.io/webhook/meet/attendee
ATTENDEE_WEBHOOK_SECRET=

# Чужой мост Attendee — остался только под Teams. Не задан — Teams выключен,
# остальные площадки работают через свой сервис выше.
# ATTENDEE_BASE_URL=
# ATTENDEE_API_KEY=

# ── Короткие ролики (src/shorts, спека 2026-10-24-promo-shorts-design.md) ──
# Рубильник кронов конвейера: съёмка, отправка на проверку, публикация.
# Включать последним — после того как в short_settings прописан канал
# (admin/shorts update_settings). Кнопки под уже присланным роликом
# (Одобрить/Переснять/Отклонить/в YouTube) и команда /short действуют и при
# выключенном рубильнике: одобренный ролик выйдет, когда рубильник снова
# включат.
# SHORTS_ENABLED=true
# Воскресное наполнение очереди и запуск роликов к слотам. На стенде — false:
# ролик запускается из админки (admin/shorts start_now).
# SHORTS_AUTO_TOPICS=true
# Стенд: пометка «СТЕНД» в сообщениях владельцу.
# SHORTS_STAND=true
# Адрес кабинета в ссылках роликов; по умолчанию https://my.linkeon.io.
# SHORTS_LINK_BASE=https://test.linkeon.io
# Апрувер роликов — тот же BLOG_APPROVER_TG_ID, что у блога (общий): ему
# приходят ролики на проверку, только он жмёт кнопки и пишет /short.
# Флаги выше включаются только строкой true — SHORTS_ENABLED=1 рубильник не включит.
