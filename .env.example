PORT=3001
NODE_ENV=production

DATABASE_URL=postgresql://linkeon:PASSWORD@localhost:5432/linkeon

REDIS_URL=redis://localhost:6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

JWT_SECRET=change_me_to_strong_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=7200
JWT_REFRESH_EXPIRES=2592000

SMSAERO_LOGIN=your_login
SMSAERO_API_KEY=your_api_key

OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
# Claude доступ — через OAuth (~/.claude/.credentials.json на сервере).
# Один раз: `claude login` под нужным пользователем. Никаких API-ключей.

YOOKASSA_SHOP_ID=...
YOOKASSA_SECRET_KEY=...

AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=...

SMS_WEBHOOK_UUID=898c938d-f094-455c-86af-969617e62f7a
CHECK_WEBHOOK_UUID=a376a8ed-3bf7-4f23-aaa5-236eea72871b
AVATAR_WEBHOOK_UUID=0cdacf32-7bfd-4888-b24f-3a6af3b5f99e

DEBUG_SMS_CODES=false

# Telegram bot integration
TG_BOT_TOKEN=
TG_WEBHOOK_URL_SECRET=
TG_WEBHOOK_HEADER_SECRET=
TG_WEBHOOK_BASE_URL=https://my.linkeon.io
TG_BOT_USERNAME=LinkeonAgentBot
TG_BOT_LOW_BALANCE_THRESHOLD=1000

# Продукты: шифрование секретов (токен бота, ключи бирж) в products.secrets_encrypted.
# 32 байта в hex, ровно 64 символа [0-9a-f]. Сгенерировать: openssl rand -hex 32
# Значения для test и прода кладёт владелец; ключ один на все продукты, коробка
# привязана к productId через AAD. Смена ключа делает старые коробки нечитаемыми —
# отличать поколения по ведущему байту версии формата.
PRODUCT_SECRETS_KEY=

# Продукты: токен агента машины продуктов. Агент живёт на машине, long-poll'ит
# бэкенд за заданиями провижининга и разворачивает контейнеры; этим токеном он
# доказывает, что он — та самая машина (не пользователь и не раннер продукта).
# Сгенерировать: openssl rand -hex 32
# Значение обязано совпадать с HOST_TOKEN в /etc/linkeon-host-agent.env на машине
# продуктов. Не совпало — агент не получит ни одного задания и промолчит: снаружи
# это выглядит как «кнопка не работает», а не как ошибка доступа.
#
# ЭТА ПЕРЕМЕННАЯ — ТОЛЬКО ЗАСЕВ. Гвард её не читает: с куска 4а токен агента и
# есть МЕТКА МАШИНЫ, а машины лежат в таблице product_hosts (sha256 токена в
# agent_token_hash — как runner_token_hash у продукта). Отсюда заводится ровно
# одна, первая — `own`, миграцией 005 при первом накате. Дальше источник правды
# один: реестр. Вторую машину и поворот токена делают правкой реестра, а
# ЭТУ ПЕРЕМЕННУЮ ПОСЛЕ ВЫКАТА ИЗ .env УДАЛЯЮТ — оставленная, она была бы вторым
# способом пройти гвард, расходящимся с реестром молча (сторож — сценарий 42а).
#
# Требования к токену проверяются на каждом запросе, не только комментарием:
#   - не короче 32 символов (заглушки вроде `test` отвергаются до базы);
#   - только печатный ASCII без пробелов — значения HTTP-заголовков латинские,
#     и неASCII-токен агенту не отправить в принципе (ERR_INVALID_CHAR), а
#     хвостовой пробел давал бы вечный 401 без подсказки.
# Пустое значение здесь не открывает вход, а закрывает: 005 не заведёт машину
# вовсе, реестр останется пустым, и гвард отвергнет всех со строкой в логе
# «реестр машин пуст» (наружу — «host registry not configured»).
# Предъявленный, но неизвестный токен — строка «неизвестный токен агента машины
# (sha256 ...)» и «Unknown host token» наружу; сам токен в лог не уезжает.
PRODUCT_HOST_TOKEN=
