[Unit]
Description=Linkeon product host agent
# Имя юнита, каталог и файл конфига совпадают до буквы: linkeon-host-agent.
# В черновике плана юнит назывался linkeon-product-host-agent, а пути в нём —
# /opt/linkeon-host-agent и /etc/linkeon-host-agent.env, и на эти же пути уже
# ссылается .env.example бэкенда. Расхождение стоит ровно одного места:
# `journalctl -u linkeon-host-agent` отвечает «unit not found», человек читает
# это как «агент не установлен» и ставит второй.

# Wants= здесь ОБЯЗАТЕЛЕН, и это не дубль соседней строки. Одинокий
# After=network-online.target ничего не подтягивает: target активируется только
# если его кто-то запросил, и без Wants= порядок соблюдается относительно
# цели, которая не запускалась вовсе. То есть агент стартует до поднятия сети,
# первый опрос падает на DNS, и в журнале установки лежит ложная улика
# «опрос не удался» на полностью исправном токене.
Wants=network-online.target
# docker.service — потому что первым делом любого задания идёт `docker ps`
# (проверка занятости имени). До старта докера это не отказ задания, а отказ
# ДО первого действия, но лишний failed в карточке клиента не нужен.
After=network-online.target docker.service

# Предел перезапусков — единственное, что отличает «агент работает» от «агент
# не может стартовать» снаружи.
#
# Умолчания systemd (StartLimitIntervalSec=10s, StartLimitBurst=5) при
# RestartSec=5 не срабатывают НИКОГДА: два перезапуска в десятисекундное окно
# — это меньше пяти. Агент с пустым HOST_TOKEN падает на loadConfig, systemd
# поднимает его снова, и так раз в пять секунд годами, а `systemctl status`
# при этом показывает зелёный `active (running)` — процесс же только что
# стартовал. Окно в 120 секунд делает пять падений подряд поводом сдаться:
# юнит уходит в `failed`, и `systemctl is-failed` отвечает `failed`.
#
# Что этот предел НЕ погасит по ошибке: агент не падает от того, что Linkeon
# лежит, токен не принят или задание провалилось, — всё это обрабатывается
# внутри цикла и процесс живёт (см. tick/loop в src/host/index.ts). Процесс
# выходит ненулевым кодом только на сломанном конфиге, то есть на поломке,
# которая сама не починится, сколько ни перезапускай.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# root — по необходимости, а не по недосмотру: у соседнего юнита раннера
# пользователь задан, здесь он тоже задан явно, чтобы «root» был решением, а
# не умолчанием systemd.
#
# Агент читает /root/.secrets/claude-oauth-token (0600 root), создаёт каталоги
# в /srv/products, делает `chown -R 1000:1000`, снимает конфиги из
# /etc/nginx/sites-products и зовёт `systemctl reload nginx`. Пользователь в
# группе docker вместо root не помог бы ничем: членство в группе docker и так
# равносильно root (`docker run -v /:/host`), а перечисленное выше требует
# root и помимо докера.
#
# Директивы изоляции (ProtectSystem=, PrivateTmp=, ReadOnlyPaths=) сюда
# намеренно не добавлены: вся работа юнита — это запись в /etc, /srv и
# управление докером, и любая из них ломает его целиком либо не запрещает
# ничего. Граница безопасности в этой схеме проходит по контейнеру продукта
# (scripts/product-host-harden.sh), а не по юниту агента.
User=root
WorkingDirectory=/opt/linkeon-host-agent
EnvironmentFile=/etc/linkeon-host-agent.env

# PATH БЕЗ каталога node — в отличие от юнита раннера, и это разница по делу,
# а не по недосмотру. Раннер зовёт node-инструменты (npm, pm2, tsc), которые
# на серверах стоят под nvm, и без их каталога падает на `pm2: not found`.
# Агент хоста не зовёт ни одного: полный список программ, которые он
# запускает, — docker, git, chown, rm, systemctl, product-vhost (все вызовы
# `run([...])` в src/host/provision.ts и sleep.ts) и certbot (задание своего
# домена, src/host/domain.ts), и все они лежат в перечисленных ниже каталогах.
# certbot — из apt, в /usr/bin. Поставленный snap-ом он живёт в /snap/bin, и
# без этого каталога в PATH каждый выпуск падал бы «certbot: not found». Второе место подстановки — это второй способ ошибиться при
# установке; там, где оно ничего не даёт, его нет.
#
# Триггер пересмотра назван прямо: как только в provision.ts появится вызов
# npm/npx/pm2 — каталог node обязан вернуться в PATH вместе с ним.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Путь к node подставляется при установке (scripts/product-host-agent-install.sh):
# захардкоженный /usr/bin/node существует не везде — на тестовой ноде node
# лежит в /usr/local/bin, у раннеров бывает под nvm, — а юнит с несуществующим
# ExecStart падает с status=203/EXEC и уходит ровно в тот молчаливый цикл
# перезапусков, от которого выше стоит StartLimitBurst.
ExecStart=__NODE__ /opt/linkeon-host-agent/dist/host/index.js
Restart=always
RestartSec=5

# Иначе в журнале строки агента подписаны `node[12345]`, как и любой другой
# node на машине, и `journalctl -t` по ним не собрать.
SyslogIdentifier=linkeon-host-agent
StandardOutput=journal
StandardError=journal

# SIGTERM посреди задания убивает вместе с агентом и его `docker run`
# (KillMode по умолчанию — вся control-group), а подчистка при этом не
# отрабатывает: на хосте остаётся полусозданный продукт, о котором сервер
# узнает только по истечении десяти минут. Ждать здесь полного провижининга
# (до восьми минут) нельзя — systemd столько держать нечем, да и перезагрузку
# это остановит. Поэтому срок короткий, а правило — в README: перед
# restart/stop убедиться, что задание не выполняется.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
