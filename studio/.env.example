# Куда смотрит студия. Образец — на стенде; конвейер (план 2) — на проде.
CABINET_URL=https://test.linkeon.io
API_URL=https://test.linkeon.io
# Basic Auth стенда «user:pass» (TEST_BASIC_AUTH из spirits_back/scripts/test-server.env.local). На проде пусто.
CABINET_BASIC_AUTH=
# Демо-аккаунт: только номер тестового шаблона 790300XXXXX.
DEMO_PHONE=79030000001
# Секрет debug-ручек той среды, куда ходит студия (DEBUG_SECRET из её .env).
DEBUG_SECRET=
# SpeechKit — те же ключи, что у бэкенда.
YANDEX_SPEECHKIT_API_KEY=
YANDEX_TTS_FOLDER_ID=
# Ключ Google (Nano Banana Pro и Omni) — оживление сценок (npm run animate). Тот же, что GOOGLE_AI_API_KEY бэкенда.
GOOGLE_AI_API_KEY=

# ── Рабочий процесс (npm run worker) ──
# База и MinIO той же среды, что API: на стенде — значения из ~/spirits_back/.env.
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_VIDEOS=linkeon-smm-videos

# ── Админка стенда с ноды (scripts/stand-admin.ts) ──
# Номер админа стенда (тестовый аккаунт из CLAUDE.md); в репозиторий не класть.
ADMIN_PHONE=
# По умолчанию — API стенда на этой же ноде, мимо Nginx.
ADMIN_API_URL=http://127.0.0.1:3001
